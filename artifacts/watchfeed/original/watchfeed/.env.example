# ---- Required ---------------------------------------------------------
# Domain pointing at this server (A record) -> automatic HTTPS. Leave blank to test on http://SERVER_IP
DOMAIN=feed.yourdomain.co.uk

# Logins (browser pop-up). Staff see the feed; admin also sees WhatsApp + groups.
STAFF_USER=staff
STAFF_PASSWORD=change-me-staff
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin

# AI extraction — create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Leave paid background processing off until the operator reviews the budget and migration.
WORKER_ENABLED=false

# Optional named staff logins for individual offer tracking. Keep passwords private.
# STAFF_USERS=ali:unique-password,sara:another-password
# Used in alert links; set this to your HTTPS feed address.
PUBLIC_URL=
# Optional Telegram/email alerts. Leave empty to disable delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_EMAILS=
DIGEST_HOUR=8

# Random secrets — generate each with:  openssl rand -hex 24
POSTGRES_PASSWORD=
WAHA_API_KEY=
WEBHOOK_SECRET=

# ---- Optional ---------------------------------------------------------
BASE_CURRENCY=GBP
# New groups start OFF so personal/family groups are never stored. Tick trading groups in /admin.
AUTO_ENABLE_NEW_GROUPS=false
# Same dealer + same watch + same price re-posted within N days counts as one offer
DUPLICATE_WINDOW_DAYS=14
LLM_CONCURRENCY=4
# Estimated USD spending limits. 0 daily means monthly / 30.
# Provider bills can differ and a single in-flight request can exceed the limit.
AI_MONTHLY_BUDGET_USD=20
AI_DAILY_BUDGET_USD=0
AI_INTERVAL_MINUTES=60
# Pending/history messages older than 24 hours are stored but not sent to AI.
AI_MAX_AGE_HOURS=24
AI_MAX_LINES_PER_CALL=40
AI_BATCH_SIZE=8
# Groups with 40 paid checked messages but zero watch offers pause automatically.
AUTO_PAUSE_AFTER=40
TARGET_MARGIN_PCT=10
IMPORT_UPLIFT_PCT=0
DEAL_THRESHOLD_PCT=8
PHOTO_RETENTION_DAYS=60
